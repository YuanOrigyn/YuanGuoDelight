# Normalise line endings so the repository stays stable across Windows/Linux checkouts.
* text=auto eol=lf

# Explicit text types
*.java    text eol=lf
*.kts     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.ps1     text eol=crlf
*.toml    text eol=lf

# Gradle wrapper scripts: shell script must stay LF, batch file must stay CRLF.
gradlew     text eol=lf
gradlew.bat text eol=crlf
# Binary assets
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ogg     binary
*.jar     binary
*.zip     binary
*.class   binary